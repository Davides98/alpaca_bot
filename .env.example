# Copia questo file in `.env` e compila i valori. `.env` è in .gitignore: NON committarlo mai.

# --- Alpaca (account PAPER: https://app.alpaca.markets -> Paper Trading -> API Keys) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Supabase (Project Settings -> API / API Keys) ---
# SUPABASE_URL = "Project URL", un indirizzo web (NON una chiave), es. https://abcdefgh.supabase.co
SUPABASE_URL=
# Chiave SECRET (sb_secret_...) o legacy service_role (eyJ...): SOLO qui e nei GitHub Secrets, mai nel frontend.
# La chiave publishable (sb_publishable_...) NON va qui: va in docs/index.html (SUPABASE_ANON_KEY).
SUPABASE_SERVICE_ROLE_KEY=

# --- Modalità di esecuzione ---
# true  = pipeline completa ma nessun ordine inviato e nessun trade scritto su Supabase
# false = invia ordini reali sull'account PAPER
DRY_RUN=false

# Solo in DRY_RUN: esegue la pipeline anche a mercato chiuso (utile per testare nel weekend)
IGNORE_MARKET_HOURS=false

# --- Parametri opzionali (sovrascrivono i default di config/settings.py) ---
# WATCHLIST=SPY,QQQ,IWM,TLT,GLD,AAPL,MSFT,NVDA,AMZN,AMD
# MIN_DTE=30
# MAX_DTE=45
# MAX_RISK_PER_TRADE_PCT=0.02
# MAX_OPEN_POSITIONS=3
# LOG_LEVEL=INFO
